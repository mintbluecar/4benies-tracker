          "key": "Permissions-Policy",
          "value": "autoplay=(self \"https://open.spotify.com\"), encrypted-media=(self \"https://open.spotify.com\"), picture-in-picture=(self \"https://open.spotify.com\"), clipboard-write=(self \"https://open.spotify.com\")"
        }
      ]
    }
  ]
}
